  "components": {
    "schemas": {
      "Candidate": {
        "properties": {
          "korean_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Korean Name"
          },
          "id": {
            "type": "string",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "title": "Candidate"
      },
      "ChatResult": {
        "properties": {
          "answer": {
            "type": "string",
            "title": "Answer"
          },
          "slot": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Plan"
              },
              {
                "type": "null"
              }
            ]
          },
          "trace": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Trace"
          },
          "sources": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Sources"
          }
        },
        "type": "object",
        "required": [
          "answer",
          "slot",
          "trace",
          "sources"
        ],
        "title": "ChatResult"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LogEntry": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "sid": {
            "type": "string",
            "title": "Sid"
          },
          "kind": {
            "type": "string",
            "title": "Kind"
          },
          "payload": {
            "type": "string",
            "title": "Payload"
          },
          "created": {
            "type": "string",
            "title": "Created"
          }
        },
        "type": "object",
        "required": [
          "id",
          "sid",
          "kind",
          "payload",
          "created"
        ],
        "title": "LogEntry"
      },
      "LogSummary": {
        "properties": {
          "sid": {
            "type": "string",
            "title": "Sid"
          },
          "events": {
            "type": "integer",
            "title": "Events"
          }
        },
        "type": "object",
        "required": [
          "sid",
          "events"
        ],
        "title": "LogSummary"
      },
      "Message": {
        "properties": {
          "session_id": {
            "type": "string",
            "format": "uuid",
            "title": "Session Id"
          },
          "run_id": {
            "type": "string",
            "format": "uuid",
            "title": "Run Id"
          },
          "message": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "session_id",
          "message"
        ],
        "title": "Message"
      },
      "Plan": {
        "properties": {
          "episode": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Episode"
          },
          "start": {
            "type": "string",
            "format": "date-time",
            "title": "Start"
          },
          "end": {
            "type": "string",
            "format": "date-time",
            "title": "End"
          }
        },
        "type": "object",
        "required": [
          "episode",
          "start",
          "end"
        ],
        "title": "Plan"
      },
      "Saved": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "overlaps": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "title": "Overlaps"
          }
        },
        "type": "object",
        "required": [
          "id",
          "overlaps"
        ],
        "title": "Saved"
      },
      "SearchError": {
        "properties": {
          "ok": {
            "type": "boolean",
            "const": false,
            "title": "Ok"
          },
          "error": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Error"
          }
        },
        "type": "object",
        "required": [
          "ok",
          "error"
        ],
        "title": "SearchError"
      },
      "SearchResult": {
        "properties": {
          "ok": {
            "type": "boolean",
            "const": true,
            "title": "Ok"
          },
          "data": {
            "items": {
              "$ref": "#/components/schemas/Candidate"
            },
            "type": "array",
            "title": "Data"
          }
        },
        "type": "object",
        "required": [
          "ok",
          "data"
        ],
        "title": "SearchResult"
      },
      "Selected": {
        "properties": {
          "session_id": {
            "type": "string",
            "format": "uuid",
            "title": "Session Id"
          },
          "run_id": {
            "type": "string",
            "format": "uuid",
            "title": "Run Id"
          },
          "message": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Message"
          },
          "character_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Character Id"
          },
          "character": {
            "type": "string",
            "maxLength": 150,
            "minLength": 1,
            "title": "Character"
          }
        },
        "type": "object",
        "required": [
          "session_id",
          "message",
          "character"
        ],
        "title": "Selected"
      },
      "StoredPlan": {
        "properties": {
          "episode": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Episode"
          },
          "start": {
            "type": "string",
            "format": "date-time",
            "title": "Start"
          },
          "end": {
            "type": "string",
            "format": "date-time",
            "title": "End"
          },
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "sid": {
            "type": "string",
            "title": "Sid"
          },
          "created": {
            "type": "string",
            "title": "Created"
          }
        },
        "type": "object",
        "required": [
          "episode",
          "start",
          "end",
          "id",
          "sid",
          "created"
        ],
        "title": "StoredPlan"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
