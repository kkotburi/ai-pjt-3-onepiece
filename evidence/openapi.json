    "/api/logs": {
      "get": {
        "summary": "Sessions",
        "operationId": "sessions_api_logs_get",
        "parameters": [
          {
            "name": "session_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Session Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/LogSummary"
                  },
                  "title": "Response Sessions Api Logs Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
